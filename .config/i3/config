# I3 Configuration Settings

set $mod Mod4
floating_modifier $mod
font pango:monospace 12
default_border pixel 1
default_floating_border pixel 0

# Force everything to be fullscreen
# workspace_layout tabbed


set $mainmon DP-3
set $sidemon HDMI-0

# Workspaces

workspace "browser" output $mainmon
workspace "cursor" output $mainmon
workspace "files" output $mainmon
workspace "zoom/huddle meeting" output $mainmon
workspace "lazygit" output $mainmon

workspace "slack" output $sidemon
workspace "1password" output $sidemon
workspace "background" output $sidemon

# Rules

for_window [floating] border pixel 0
for_window [tiling] border pixel 1
for_window [class="zoom"] floating enable
for_window [class="zoom" title="Zoom - Licensed Account"] floating disable
for_window [class="zoom" title="Zoom Meeting"] floating disable

# assign [class="Slack"] "slack"
# assign [class="1Password"] "1password"
# assign [class="Brave-browser"] "browser"
# assign [class="Cursor"] "cursor"
# assign [class="Zoom"] "zoom/huddle meeting"

bindsym $mod+1 exec go-to-index 0
bindsym $mod+2 exec go-to-index 1
bindsym $mod+3 exec go-to-index 2
bindsym $mod+4 exec go-to-index 3
bindsym $mod+5 exec go-to-index 4

# Keybindings

# bindsym $mod+Shift+e exec i3-msg exit
bindsym $mod+Shift+r restart
bindsym $mod+Shift+q kill

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right


bindsym $mod+Right split h
bindsym $mod+Down split v

bindsym $mod+f fullscreen toggle

bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output
bindsym $mod+space exec go-to-workspace
bindsym $mod+Shift+space exec send-to-workspace

bindsym $mod+b bar mode toggle

bindsym $mod+Return exec xfce4-terminal -e zsh
bindsym $mod+Shift+d exec rofi -modi run -show run
bindsym $mod+d exec rofi -modi drun -show drun
bindsym $mod+e exec nautilus
bindsym $mod+g exec rofi -modi window -show window
bindsym $mod+p exec flameshot gui
bindsym $mod+w exec brave-browser

# Colors

set $bg_color "#282C34"
set $fg_color "#ABB2BF"
set $accent_color "#61AFEF"
set $accent_color2 "#C678DD"
set $accent_color3 "#56B6C2"
set $good_color "#98C379"
set $warn_color "#E5C07B"
set $error_color "#E06C75"


# class                 border        backgr.   text      indicator     child_border
client.focused          $accent_color $bg_color $fg_color $accent_color $accent_color
client.focused_inactive $fg_color     $bg_color $fg_color $fg_color     $fg_color
client.unfocused        $fg_color     $bg_color $fg_color $fg_color     $fg_color
client.urgent           $warn_color   $bg_color $fg_color $warn_color   $warn_color
client.placeholder      $bg_color     $bg_color $fg_color $bg_color     $bg_color
client.background       $bg_color


bar {

    position top
    font pango:Droid Sans Mono, FontAwesome 10
    tray_output primary

    colors {
        background $bg_color
        statusline $fg_color
        separator $fg_color

        focused_workspace $accent_color $accent_color #000000
        active_workspace $fg_color $bg_color $fg_color
        inactive_workspace $bg_color $bg_color $fg_color
        urgent_workspace $error_color $bg_color $error_color
        binding_mode $good_color $bg_color $good_color
    }

    status_command i3status

}

exec_always --no-startup-id /home/swilson/.local/bin/autostart
exec_always --no-startup-id /home/swilson/.screenlayout/i3-2-monitor.sh
